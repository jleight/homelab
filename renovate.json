{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.hcl$/"
      ],
      "matchStrings": [
        "(?<depName>\\S+?) = {\\s+?renovate\\s+?=\\s\"(?<datasource>[^\"]+?)\"\\s+?repository\\s+?=\\s\"(?<packageName>[^\"]+?)\"\\s+?version\\s+?=\\s\"(?<currentValue>[^\"]+?)\"",
        "(?<depName>\\S+?) = {\\s+?renovate\\s+?=\\s\"(?<datasource>[^\"]+?)\"\\s+?repository\\s+?=\\s\"(?<registryUrl>[^\"]+?)\"\\s+?chart\\s+?=\\s\"(?<packageName>[^\"]+?)\"\\s+?version\\s+?=\\s\"(?<currentValue>[^\"]+?)\"",
        "(?:\\S+?) = {\\s+?renovate\\s+?=\\s\"(?<datasource>[^\"]+?)\"\\s+?image\\s+?=\\s\"(?<packageName>(?:.+/)?(?<depName>[^\"]+))\"\\s+?version\\s+?=\\s\"(?<currentValue>[^\"]+?)\"(?:\\s+?digest\\s+?=\\s\"(?<currentDigest>[^\"]+?)\")?"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.hcl$/"
      ],
      "matchStrings": [
        "k8s_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "kubernetes",
      "packageNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.tf$/"
      ],
      "matchStrings": [
        "talos_version\\s*=\\s*optional\\(string,\\s*\"(?<currentValue>[^\"]+)\"\\)"
      ],
      "depNameTemplate": "talos",
      "packageNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Batch the monitoring charts into one PR; they are independent components of the same stack and are applied together",
      "matchDepNames": [
        "metrics_server",
        "victoria_metrics",
        "node_exporter",
        "kube_state_metrics"
      ],
      "groupName": "monitoring charts"
    },
    {
      "description": "Keep Bifrost on the `v`-prefixed image tags. The unprefixed `2.x` tags in the same Docker Hub repo are the Helm chart published as an OCI artifact, not a container image, so an ordinary version bump would point the Deployment at something that cannot run. The regex also excludes the `v2.0.0-prereleaseN` tags.",
      "matchDepNames": [
        "bifrost"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Keep AnythingLLM on the `pg-` tag series. The unprefixed tags are the SQLite build of the same release, so an ordinary version bump would silently point a Postgres-backed deployment at an image that ignores DATABASE_URL.",
      "matchDepNames": [
        "anythingllm"
      ],
      "versioning": "regex:^pg-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
